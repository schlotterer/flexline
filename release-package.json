{
  "schema": 1,
  "slug": "flexline",
  "repository": "schlotterer/flexline",
  "type": "theme",
  "entry": "style.css",
  "node": true,
  "include": [
    "functions.php",
    "style.css",
    "theme.json",
    "screenshot.png",
    "inc",
    "parts",
    "patterns",
    "styles",
    "templates",
    "assets",
    "vendor",
    "LICENSE"
  ],
  "required": [
    "functions.php",
    "style.css",
    "theme.json",
    "screenshot.png",
    "vendor/autoload.php",
    "vendor/enshrined/svg-sanitize/src/Sanitizer.php",
    "assets/built/css/app.css",
    "assets/built/css/editor.css",
    "assets/built/js/load-early.js",
    "assets/fonts/REM/REM-VariableFont_wght.woff2"
  ],
  "generated": [
    "build",
    "assets/built",
    "assets/vendor",
    "vendor"
  ],
  "checks": [
    [
      "npm",
      "run",
      "lint-js"
    ],
    [
      "npm",
      "run",
      "lint-style"
    ],
    [
      "vendor/bin/phpunit",
      "--configuration",
      "phpunit.xml.dist"
    ],
    [
      "npm",
      "run",
      "test:primary-terms"
    ]
  ],
  "compatibility": {
    "wordpress": "Verify package declared requirements and tested target before deployment.",
    "dependencies": "FlexLine parent compatibility must be checked against relevant child themes.",
    "recovery": "Reinstall retained prior supported ZIP against updated data; test upgrade and recovery before acceptance. Irreversible migrations require a separately documented tested recovery path."
  }
}
